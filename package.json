{
  "name": "agent-button",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first agent automation control plane: buttons, workflows, schedules, approvals for coding agents",
  "license": "MIT",
  "homepage": "https://cskwork.github.io/agent-button/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cskwork/agent-button.git"
  },
  "bugs": {
    "url": "https://github.com/cskwork/agent-button/issues"
  },
  "keywords": [
    "ai-agents",
    "automation",
    "claude-code",
    "codex",
    "opencode",
    "workflow-engine",
    "tui",
    "local-first",
    "bun"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "daemon": "bun run apps/daemon/src/main.ts",
    "tui": "bun run apps/tui/src/main.ts",
    "web": "bun run apps/web/src/main.ts",
    "cli": "bun run apps/cli/src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
